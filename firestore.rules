rules_version = '2';

// ============================================================
// Johoe — Firestore 보안 규칙
//
// 핵심 원칙
//  1) 교사 데이터(classes, attendance)는 소유 교사만 접근한다.
//  2) 학생 열람용(public)은 누구나 읽을 수 있으므로,
//     애초에 이름·출결이 들어가지 않는 문서만 여기에 둔다.
//  3) 반 비밀번호는 보안 장치가 아니다. 실제 보호는 이 규칙이 담당한다.
//
// 이 앱은 반 문서 ID를 교사의 계정 ID(uid)로 쓴다.
// 따라서 "문서 ID == 내 uid" 만으로 소유 판정이 성립하며,
// 문서가 아직 없는 첫 로그인에서도 안전하게 통과한다.
// (문서가 없을 때 resource.data 를 읽으면 평가가 실패해 접근이 거부된다)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 여부
    function signedIn() {
      return request.auth != null;
    }

    // 내 반인지 — 문서가 없어도 판정할 수 있다
    function isMine(classId) {
      return signedIn() && classId == request.auth.uid;
    }

    // ---------- 교사 전용: 반 문서 ----------
    match /classes/{classId} {

      // 문서가 없는 첫 로그인도 통과해야 한다
      allow read: if isMine(classId);

      // 생성 시 소유자를 본인으로 강제한다
      allow create: if isMine(classId)
                    && request.resource.data.ownerUid == request.auth.uid;

      // 수정 시에도 소유자 필드는 본인이어야 한다
      allow update: if isMine(classId)
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if isMine(classId);
    }

    // ---------- 교사 전용: 출결 ----------
    // 문서 ID 형식: {classId}_{YYYY-MM-DD}
    match /attendance/{docId} {

      // docId 앞부분에서 classId 를 꺼낸다
      function classIdOf() {
        return docId.split('_')[0];
      }

      allow read, write: if isMine(classIdOf());
    }

    // ---------- 학생 열람용 ----------
    // 누구나 읽을 수 있다. 따라서 이 문서에는
    // 학생 이름·좌석·출결·교사 메모를 절대 넣지 않는다.
    match /public/{classId} {
      allow read: if true;
      allow write: if isMine(classId);
    }

    // ============================================================
    // ---------- 1P1J (1인 1역 배정 앱) ----------
    // 같은 프로젝트에 새로 얹은 앱. roleAssign_ 접두어 컬렉션 아래에서만 동작하고
    // 위 classes / attendance / public 컬렉션과는 전혀 겹치지 않는다.
    //
    // 설계 메모:
    // - students/{학번}, roles/{roleId} 는 학생이 QR로 접속했을 때(비로그인) 이름 확인과
    //   지망 선택을 위해 공개 읽기를 허용한다. 같은 반 학생끼리는 어차피 서로의 번호/이름/
    //   역할 목록을 아는 정보라 노출에 문제가 없다. (보호 대상은 "지망"과 "배정 결과".)
    // - students 의 문서 ID를 학번 값 자체로 쓴다. preferences 도 마찬가지로 학번을 문서 ID로
    //   써서, "명단에 없는 학번은 제출 불가"를 exists() 로 간단히 검증할 수 있게 한다.
    // - preferences(지망)와 drafts(배정 결과)는 학급 소유 교사만 읽을 수 있다.
    // - 교사는 구글 로그인 또는 익명 로그인 중 하나를 쓴다. 둘 다 uid 를 받으므로
    //   ownerUid 기반 소유 판정은 동일하게 동작한다.
    // ============================================================
    match /roleAssign_classes/{classId} {
      allow read: if true; // className, submissionOpen 은 학생도 봐야 하므로 공개 읽기
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      function isOwner() {
        return request.auth != null &&
          get(/databases/$(database)/documents/roleAssign_classes/$(classId)).data.ownerUid == request.auth.uid;
      }
      function submissionIsOpen() {
        return get(/databases/$(database)/documents/roleAssign_classes/$(classId)).data.submissionOpen == true;
      }
      // 파라미터 이름으로 number 를 쓰지 않는다 — rules 언어에서 number 는 타입 이름이라
      // (x is number) 파서를 헷갈리게 할 여지가 있다.
      function rosterHasStudent(studentNo) {
        return exists(/databases/$(database)/documents/roleAssign_classes/$(classId)/students/$(studentNo));
      }

      match /students/{studentNumber} {
        allow read: if true; // 학생 본인 확인 화면에서 비로그인 상태로 이름을 조회해야 함
        allow write: if isOwner();
      }

      match /roles/{roleId} {
        allow read: if true; // 학생이 지망 선택 화면에서 역할 목록을 봐야 함
        allow write: if isOwner();
      }

      match /preferences/{studentNumber} {
        allow read: if isOwner(); // 학생은 다른 학생의 지망을 읽을 수 없음
        allow write: if isOwner() || (
          // 로그인 여부는 따지지 않는다. 교사가 익명 로그인으로 앱을 쓰기 시작하면서
          // 학생 기기에도 auth 세션이 남아 있을 수 있기 때문. 원래도 비로그인 쓰기를
          // 허용하던 경로라, 실제 방어선은 아래 세 조건(접수 중 · 명단에 있는 학번 ·
          // 지망 1~3개)이며 보안 수준은 달라지지 않는다.
          submissionIsOpen() &&
          rosterHasStudent(studentNumber) &&
          request.resource.data.choices is list &&
          request.resource.data.choices.size() >= 1 &&
          request.resource.data.choices.size() <= 3
        );
      }

      match /drafts/{draftId} {
        allow read, write: if isOwner(); // 배정 결과는 교사만
      }
    }

    // ---------- 그 외 전부 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
